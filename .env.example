# ValetTracker — copy to .env and fill in. In Komodo, paste this into the
# stack's Environment box instead of creating a file.

# Image to pull. Replace OWNER with your GitHub username or org (lowercase).
VT_IMAGE=ghcr.io/OWNER/valettracker:latest

# Port on the host. The app always listens on 8000 inside the container.
HOST_PORT=8080

# Shown in the header so staff know which stand they are signed in to.
LOT_NAME=Main Lot
TZ=America/Los_Angeles

# Signs session cookies. Generate one with:
#   openssl rand -hex 32
# Change this and everyone is signed out. Leave it empty and a random key is
# generated at boot, which signs everyone out on every restart.
SECRET_KEY=replace-me-with-openssl-rand-hex-32

# PIN for valets: park cars, move tickets, edit details.
STAFF_PIN=1234

# PIN for a manager: everything above, plus deleting tickets.
# Leave empty to skip the second role entirely.
ADMIN_PIN=907142

# How long a sign-in lasts. A full shift plus slack is the useful setting.
SESSION_HOURS=12

# Set to true only when the app is served over HTTPS, which tells the browser
# to stop sending the session cookie over plain HTTP.
COOKIE_SECURE=false
